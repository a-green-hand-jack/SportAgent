  {
    "id": "rule_prog_003",
    "category": "progression",
    "applies_to_goals": [],
    "applies_to_levels": ["beginner"],
    "rule_type": "constraint",
    "description": "新手起始重量选择指引：选择能勉强完成15次的重量，然后减少10-15%作为起始重量。例如能做15次但最后几次很费力的10kg哑铃，从8-9kg开始训练。前2周专注于动作技术，第3周开始按进阶规则加重。",
    "parameters": {
      "starting_rm_percentage": 0.75,
      "technique_focus_weeks": 2
    }
  },
  {
    "id": "rule_prog_004",
    "category": "progression",
    "applies_to_goals": [],
    "applies_to_levels": [],
    "rule_type": "constraint",
    "description": "渐进超负荷触发与执行规则：当某动作连续2次训练均完成全部组数且达到次数区间上限时，下次训练增加重量。小肌群孤立动作（二头弯举、三头伸展等）每次加1-2kg；大肌群复合动作（深蹲、硬拉、卧推、划船等）每次加2.5-5kg。若无法增重，则优先增加次数或组数。",
    "parameters": {
      "trigger": "all_sets_completed_at_rep_max_for_2_consecutive_sessions",
      "small_muscle_increment_kg_range": [1, 2],
      "large_muscle_increment_kg_range": [2.5, 5]
    }
  },
  {
    "id": "rule_prog_005",
    "category": "progression",
    "applies_to_goals": [],
    "applies_to_levels": ["intermediate", "advanced"],
    "rule_type": "recommendation",
    "description": "每隔4-6周安排1周减量训练（Deload）：将所有训练重量降低20-30%，组数减少约一半，保持动作质量。减量周有助于消除积累疲劳，防止过度训练，并为下一训练阶段蓄力。",
    "parameters": {
      "deload_frequency_weeks": [4, 6],
      "deload_weight_reduction_percent": [20, 30],
      "deload_sets_reduction_percent": 50
    }
  },
  {
    "id": "rule_struct_005",
    "category": "structure",
    "applies_to_goals": [],
    "applies_to_levels": [],
    "rule_type": "constraint",
    "description": "训练日排课约束：生成的训练日数量必须严格等于用户指定的每周训练天数，不得多也不得少。同一主要肌群（如胸、背、腿）的训练日之间必须至少间隔1个休息日（即不得在连续两天训练同一肌群）。",
    "parameters": {
      "training_days_must_match_user_request": true,
      "min_rest_days_between_same_muscle_group": 1
    }
  },
